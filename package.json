{
  "name": "origin-of-slime",
  "version": "0.1.0",
  "private": true,
  "description": "슬라임의 기원 | Origin of Slime — 유전·진화 생존 게임",
  "main": "electron/main.js",
  "scripts": {
    "test": "node test/check-syntax.mjs && node test/smoke-save.mjs && node test/smoke-ach.mjs && node test/smoke-boss.mjs && node test/smoke-evo.mjs && node test/smoke-visual.mjs",
    "serve": "python3 -m http.server 8080",
    "start": "electron . --dev",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.1"
  },
  "build": {
    "appId": "com.ganggun.originofslime",
    "productName": "Origin of Slime",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": { "target": "portable" },
    "linux": { "target": "dir" }
  }
}
